# Copy to .env for local runs:  set -a && source .env && set +a
# In production these live in GitHub repo Settings > Secrets and variables > Actions.

# --- Copywriting (optional for --dry-run; without it you get extractive text)
ANTHROPIC_API_KEY=sk-ant-...

# --- Instagram (Graph API)
# IG_USER_ID is the Instagram *professional* account id, not your @handle.
IG_USER_ID=178414...
IG_ACCESS_TOKEN=IGQVJ...

# --- YouTube (Data API v3)
YT_CLIENT_ID=1234-abc.apps.googleusercontent.com
YT_CLIENT_SECRET=GOCSPX-...
YT_REFRESH_TOKEN=1//0g...

# --- Approval gate (Telegram)
TELEGRAM_BOT_TOKEN=123456:AAH...
TELEGRAM_CHAT_ID=987654321

# --- Asset hosting: Instagram fetches media from a public URL
# "github_release" (default) needs a PUBLIC repo; GH_TOKEN and
# GITHUB_REPOSITORY are injected automatically inside GitHub Actions.
ASSET_HOST=github_release

# Use "s3" instead if you want to keep the repo private:
# ASSET_HOST=s3
# S3_BUCKET=my-bucket
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com   # omit for AWS S3
# ASSET_BASE_URL=https://assets.example.com
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
